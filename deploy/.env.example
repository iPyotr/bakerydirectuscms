# ==========================================================================
#  Portainer stack variables — заполняете в UI (Stacks → Environment variables)
#  Стек: bakery (Directus + Frontend). External: только PostgreSQL + SMTP.
# ==========================================================================

# =========================
#  Docker images & network
# =========================
# Frontend image в GHCR (без тега)
FRONTEND_IMAGE=ghcr.io/ipyotr/bakerydirectuscms-frontend
FRONTEND_IMAGE_TAG=latest

# Directus docker-hub тег (рекомендуется пин на мажор)
DIRECTUS_VERSION=11
# Postgres image тег
POSTGRES_VERSION=17-alpine

# Имя внешней docker-сети для Caddy (создать: `docker network create web`)
WEB_NETWORK=web

# Порт на хосте (для прямого проброса, если нет caddy-docker-proxy)
FRONTEND_HOST_PORT=3000

# Публичные hostname (для caddy labels — опционально)
FRONTEND_HOSTNAME=delovkusa.openlabio.ru
DIRECTUS_HOSTNAME=admin.delovkusa.openlabio.ru

# =========================
#  Directus security & URLs
# =========================
# Публичный URL Directus (https, с доменом). Используется и браузером, и сам Directus шлёт его в emails/OAuth.
DIRECTUS_PUBLIC_URL=https://admin.delovkusa.openlabio.ru
# Сгенерировать: `openssl rand -hex 32` (НЕ коммитить!)
DIRECTUS_KEY=change-me-directus-key
DIRECTUS_SECRET=change-me-directus-secret

# Первый админ — создаётся автоматически при первом запуске пустой БД.
# Этими кредами вы войдёте в https://admin.delovkusa.openlabio.ru/admin
ADMIN_EMAIL=admin@delovkusa.ru
ADMIN_PASSWORD=change-me-admin-password
# API-токен первого админа (для скриптов/CI). Оставьте пустым — сгенерируется сам,
# или задайте свой через `openssl rand -hex 24`.
ADMIN_TOKEN=

# Cookie domain (с точкой в начале = и поддомены)
REFRESH_TOKEN_COOKIE_DOMAIN=.delovkusa.openlabio.ru
SESSION_COOKIE_DOMAIN=.delovkusa.openlabio.ru

# =========================
#  PostgreSQL
# =========================
# `internal-db` — поднимать контейнер bakery_postgres в стеке (default).
# пусто (`COMPOSE_PROFILES=`) — использовать ВНЕШНИЙ PG, контейнер не поднимается.
COMPOSE_PROFILES=internal-db

# Хост и порт. Для internal оставьте дефолты. Для внешнего — укажите IP/домен.
DATABASE_HOST=bakery_postgres
DATABASE_PORT=5432

# БД, пользователь, пароль (для internal — контейнер создаст их на первом запуске;
# для внешнего — они должны уже существовать и иметь права CREATE/ALTER).
DATABASE_NAME=bakery_directus_db
DATABASE_USERNAME=bakery_directus_user
DATABASE_PASSWORD=change-me-db-password

# SSL для внешнего managed-Postgres (Supabase / Neon / AWS RDS): true
DATABASE_SSL=false

# Пул соединений и таймаут (Directus)
DB_POOL_MIN=5
DB_POOL_MAX=50
DB_CONNECT_TIMEOUT=30000

# =========================
#  SMTP (Yandex)
# =========================
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=indexio.home@yandex.ru
SMTP_PASSWORD=change-me-smtp-app-password
SMTP_FROM_NAME=Дело Вкуса
SMTP_FROM_EMAIL=indexio.home@yandex.ru

# =========================
#  CORS & security
# =========================
CORS_ENABLED=true
CORS_ORIGIN=https://delovkusa.openlabio.ru
CORS_METHODS=GET,POST,PATCH,DELETE,PUT
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Project-Key
RATE_LIMITER_ENABLED=true
RATE_LIMITER_POINTS=100
RATE_LIMITER_DURATION=1
CACHE_ENABLED=true
PUBLIC_REGISTER=false
TELEMETRY=false

# =========================
#  Directus assets / GraphQL
# =========================
GRAPHQL_INTROSPECTION=true
QUERY_LIMIT_MAX=1000
GRAPHQL_QUERY_COMPLEXITY_LIMIT=10000
ASSETS_CACHE_TTL=31536000
ASSETS_TRANSFORM_MAX_CONCURRENT=4
ASSETS_TRANSFORM_IMAGE_MAX_DIMENSION=2048

# =========================
#  Logging
# =========================
LOG_LEVEL=info
LOG_STYLE=pretty

# =========================
#  Frontend runtime
# =========================
# true = фронт берёт данные из Directus, false = моки
USE_DIRECTUS=true
