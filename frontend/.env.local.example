# Directus backend (server-side only — can be changed without rebuild)
# DIRECTUS_URL        — internal URL (docker-service-name in compose, or public URL in dev)
# DIRECTUS_PUBLIC_URL — what the browser sees. Defaults to DIRECTUS_URL if omitted.
DIRECTUS_URL=https://admin.delovkusa.openlabio.ru
DIRECTUS_PUBLIC_URL=https://admin.delovkusa.openlabio.ru
# Set to "true" to fetch data from Directus. "false" (default) serves local mocks.
USE_DIRECTUS=false

# When Directus fails, fall back to local mocks (default true). Set to "false"
# in production if you'd rather surface errors than silently mask outages.
DIRECTUS_USE_FALLBACK_MOCKS=true

# Public site URL — used in metadata, canonical links, sitemap, robots.
SITE_URL=http://localhost:3000

# Admin token for pnpm seed (create collections, upload files, insert data).
# Get it at https://<your-directus>/admin → user profile → Token → Save.
# DIRECTUS_ADMIN_TOKEN=

# Secret for /api/revalidate — Directus Flow webhook uses this to purge ISR cache.
# Generate: `openssl rand -hex 24`
# REVALIDATE_SECRET=
