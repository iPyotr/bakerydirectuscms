# Directus backend (server-side only — can be changed without rebuild)
# DIRECTUS_URL        — internal URL (docker-service-name in compose, or public URL in dev)
# DIRECTUS_PUBLIC_URL — what the browser sees. Defaults to DIRECTUS_URL if omitted.
DIRECTUS_URL=https://admin.delovkusa.openlabio.ru
DIRECTUS_PUBLIC_URL=https://admin.delovkusa.openlabio.ru
# Set to "true" to fetch data from Directus. "false" (default) serves local mocks.
USE_DIRECTUS=false
